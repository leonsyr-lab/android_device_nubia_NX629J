// Prebuilt crypto blobs for Nubia Red Magic 3 (NX629J) TWRP recovery
// Qualcomm-proprietary HIDL services needed for FBE/ICE decryption
//
// LESSON: AOSP 12 build system forbids ELF files in PRODUCT_COPY_FILES.
// Use cc_prebuilt_binary / cc_prebuilt_library_shared instead.

// === Service binaries ===

cc_prebuilt_binary {
    name: "android.hardware.keymaster@4.1-service-qti",
    srcs: ["vendor/nubia/NX629J/vendor/bin/hw/android.hardware.keymaster@4.1-service-qti"],
    vendor: true,
    recovery_available: true,
}

